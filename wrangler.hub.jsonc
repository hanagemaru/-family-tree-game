{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horse-pedigree-hub",
  "main": "src/server/worker.js",
  "compatibility_date": "2026-11-01",
  // Play counting (visit/start/complete). Set to "off" to stop; see docs/gameplay-analytics-2026-11-24.md.
  "vars": { "GAMEPLAY_ANALYTICS_MODE": "production" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "horse-pedigree-ranking",
      "database_id": "5272fcd6-f227-424d-b6f5-f3d5959c2206",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "hanage.app/games/horse-pedigree/play/*", "zone_name": "hanage.app" },
    { "pattern": "hanage.app/games/horse-pedigree/play", "zone_name": "hanage.app" }
  ],
  "observability": { "enabled": true }
}
